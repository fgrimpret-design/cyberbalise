# CyberBalise — configuration Apache (hébergement IONOS Linux)
RewriteEngine On

# 1. Forcer HTTPS et l'adresse sans « www » (https://cyberbalise.fr)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://cyberbalise.fr/$1 [R=301,L]

# 2. Adresses propres : /a-propos -> /a-propos/ ; index.html jamais affiché dans l'adresse
DirectoryIndex index.html index.php
DirectorySlash On
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# 3. Page d'erreur
ErrorDocument 404 /404.html

# 4. Sécurité
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
<FilesMatch "\.(md|py|bak|sqlite.*|log|ini|sh)$">
  Require all denied
</FilesMatch>

# 5. Cache navigateur (polices et images : 1 an ; pages : revalidation)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/csv
</IfModule>
AddType font/woff2 .woff2
AddType text/csv .csv
